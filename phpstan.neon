includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/shipmonk/phpstan-rules/rules.neon

services:
    -
        class: DevTools\PHPStan\ApplicationCallResolver
        arguments:
            applicationDirectory: %currentWorkingDirectory%/app
    -
        class: DevTools\PHPStan\NamedArgumentsRule
        arguments:
            checkedDirectories:
                - %currentWorkingDirectory%/app
                - %currentWorkingDirectory%/bin
                - %currentWorkingDirectory%/config
        tags:
            - phpstan.rules.rule

parameters:
    shipmonkRules:
        forbidCheckedExceptionInCallable:
            # Scheduler stores callbacks and propagates their failures when events run.
            allowedCheckedExceptionCallables:
                Illuminate\Console\Scheduling\Schedule::call: 0
                # These boundaries invoke callbacks synchronously and catch their checked exceptions.
                App\Scheduler\Infrastructure\Database\PostgresRunTransaction::run: 0
                App\Scheduler\Infrastructure\Database\PostgresRunTransaction::reserve: 0
                App\Scheduler\Infrastructure\Database\PostgresRunTransaction::execute: 0
                Tests\Support\Storage\StorageTestRunner::run: 0
                # Contract callbacks run inside the acceptance runner's failure boundary.
                Tests\Support\Recovery\RecoveryCase::__construct: 0
                Tests\Integration\Storage\PostgresStorageFailureTest::fails: 0
    stubFiles:
        - tools/phpstan/dibi.stub
    level: max
    phpVersion: 80500
    paths:
        - app
        - bin
        - config
        - tools/adapter-ui
        - tools/phpstan/src
        - tests
        - ecs.php
    tmpDir: /tmp/emorfiq-phpstan
    scanDirectories:
        - vendor/symplify/easy-coding-standard/vendor/friendsofphp/php-cs-fixer/src
        - vendor/squizlabs/php_codesniffer/src
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideThrowTypesInProtectedAndPublicMethods: true
    checkMissingOverrideMethodAttribute: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportAnyTypeWideningInVarTag: true
    reportAlwaysTrueInLastCondition: true
    rememberPossiblyImpureFunctionValues: false
    exceptions:
        implicitThrows: false
        checkedExceptionClasses:
            - Exception
        uncheckedExceptionClasses:
            - LogicException
        check:
            missingCheckedExceptionInThrows: true
            throwTypeCovariance: true
            tooWideImplicitThrowType: true
