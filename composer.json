{
    "name": "emorfiq/scheduler-adapter",
    "description": "PHP adapter for scheduler",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "dragonmantank/cron-expression": "^3.6",
        "monolog/monolog": "^3.0",
        "nette/schema": "^1.4",
        "nette/utils": "^4.1",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "shipmonk/phpstan-rules": "^4.4",
        "slevomat/coding-standard": "^8.31",
        "symplify/easy-coding-standard": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "DevTools\\LogViewer\\": "tools/log-viewer/src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "check": [
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
            "@php vendor/bin/ecs check --no-progress-bar",
            "@test"
        ],
        "test": "@php tests/run.php",
        "fix": "@php vendor/bin/ecs check --fix --no-progress-bar"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "platform": { "php": "8.5.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
